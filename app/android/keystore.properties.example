# Release signing for Aether. Copy to `keystore.properties` and fill in.
#
# Both `keystore.properties` and `*.jks` are gitignored. Never commit either.
# Without this file the release build still compiles, but it is debug-signed
# and Gradle prints a warning — that APK must not be distributed.
#
# Create the keystore once:
#
#   keytool -genkeypair -v \
#     -keystore android/aether-release.jks \
#     -alias aether \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Back the .jks and its passwords up somewhere that survives this laptop dying.
# Losing the key means no future build can ever update an installed app, and
# on Play it means the listing can never be updated again.
#
# `storeFile` is resolved relative to the `android/` directory.

storeFile=aether-release.jks
storePassword=CHANGEME
keyAlias=aether
keyPassword=CHANGEME
